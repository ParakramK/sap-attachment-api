# Copy to .env for local runs: cp .env.example .env
# Loaded at startup, not build time. Use --config /path/to/.env or
# CONFIG_FILE=/path/to/.env if not running from this directory.
# Real environment variables override anything set here.
# Listen address: ADDR=:8080, or just set PORT (overrides ADDR's port).
ADDR=:8080
# PORT=9090
# In Docker, pass variables directly: .env is not bundled into the image.

# --- API ---
API_KEYS=local-dev-key

# --- Storage: choose ONE backend ---
# local = files on disk (default). smb = service writes straight to a share.
STORAGE_BACKEND=local

# Used when STORAGE_BACKEND=local
STORAGE_DIR=./data/storage

# Always local, for BOTH backends: SQLite needs local file locking, and
# uploads are hashed here before being committed to their backend.
DB_PATH=./data/attachments.db
STAGING_DIR=./data/staging

# Used only when STORAGE_BACKEND=smb.
# Example target: \\192.168.1.10\nas\attachments
# Set STORAGE_BACKEND=smb above, then uncomment/edit this block:
# All comments on their own line: godotenv keeps inline "# ..." as the value.
# SMB_SERVER=192.168.1.10
#   host or host:port (445 default)
# SMB_SHARE=nas
#   share name after the server
# SMB_BASE_DIR=attachments
#   folder inside the share; empty = share root
# SMB_USERNAME=svc
#   NTLMv2 service account
# SMB_PASSWORD=
#   secret
# SMB_DOMAIN=
#   optional AD domain
# SMB_REQUIRE_SIGNING=true
# SMB_STAGING_DIR=staging
#   commit staging folder inside the share

# --- Remote-source ingestion (optional; unrelated to storage backend) ---
# FETCH_TIMEOUT=60s
# FETCH_ALLOW_PRIVATE_NET=false
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ALLOWED_BUCKETS=

# --- SAP Service Layer (optional; disabled when unset) ---
# After committing a file, register it as an SAP attachment entry.
# Set all four together; SourcePath is the stored file's directory.
# SAP_DATABASE=SBODEMO
# SAP_SERVICE_LAYER_URL=https://sap-host:50000
# SAP_USERNAME=manager
# SAP_PASSWORD=
# SAP_INSECURE_SKIP_VERIFY=false   # only for self-signed SAP certs

# --- Optional tuning (defaults shown) ---
# MAX_UPLOAD_MB=50
# SQL_DEBUG=false             # verbose SQL logging (very noisy)
# LOG_LEVEL=info
# LOGTAIL_TOKEN=
# LOGTAIL_LEVEL=info
# SHUTDOWN_TIMEOUT=15s
